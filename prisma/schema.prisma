generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model VerificationCode {
  id              String   @id @default(cuid())
  email           String
  code            String
  applicationType String
  ip              String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@unique([email, applicationType])
  @@index([ip, createdAt])
  @@index([expiresAt])
}

model Committee {
  id          Int      @id @default(autoincrement())
  sortOrder   Int      @default(0)
  name        String
  slug        String   @unique
  imageUrl    String
  description String   @db.Text
  documents   Json?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SecretariatMember {
  id          Int      @id @default(autoincrement())
  sortOrder   Int      @default(0)
  name        String
  slug        String   @unique
  role        String
  imageUrl    String
  bio         String   @db.Text
  instagram   String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ConferenceSettings {
  id                 Int      @id @default(1)
  data               Json
  applicationsClosed Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model KvkkApplication {
  id              String   @id @default(cuid())
  fullName        String
  identityNumber  String
  email           String
  phone           String?
  requestDetails  String   @db.Text
  applicationDate DateTime
  status          String   @default("received")
  createdAt       DateTime @default(now())

  @@index([email, createdAt])
}

model Application {
  id              String   @id @default(cuid())
  sourceKey       String   @unique
  sourceHash      String?
  applicationType String
  fullName        String
  email           String
  phone           String?
  school          String?
  status          String   @default("pending")
  givenCommittee  String?
  allocation      String?
  notes           String?  @db.Text
  answers         Json?
  appliedAt       DateTime?
  lastEmailSentAt DateTime?
  lastEmailStatus String?
  statusEmailSent Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  emailLogs       ApplicationEmailLog[]

  @@index([applicationType, status])
  @@index([status, appliedAt])
  @@index([email])
  @@index([appliedAt])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  statusKey String   @unique
  subject   String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApplicationEmailLog {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  templateKey   String?
  recipient     String
  subject       String
  status        String      @default("sent")
  resendId      String?     @unique
  error         String?     @db.Text
  sentAt        DateTime    @default(now())

  @@index([applicationId, sentAt])
  @@index([sentAt])
}
